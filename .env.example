# Konfigurasi Server & Hosting BOYANG DIGITAL
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Rahasia Session Cookie (Wajib diganti saat production!)
SESSION_SECRET=boyang-digital-super-secret-change-in-production-2026

# Lokasi Database SQLite & Upload Bukti Transfer
DATABASE_PATH=./data/boyang-digital.db
UPLOADS_DIR=./data/uploads

# Mode Sandbox Pembayaran (true = tersedia tombol Simulasi Bayar Instan untuk testing/demo QRIS)
PAYMENT_SANDBOX_MODE=true

# Kredensial Default Admin (Dibuat otomatis saat inisialisasi pertama)
ADMIN_EMAIL=admin@boyangdigital.id
ADMIN_PASSWORD=AdminBoyang#2026
DEMO_USER_EMAIL=user@boyangdigital.id
DEMO_USER_PASSWORD=UserBoyang#2026

# Konfigurasi Opsional Payment Gateway Live (Midtrans / Xendit)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=

# Web3 Treasury Default (Dapat diubah juga lewat Dashboard Admin)
WEB3_TREASURY_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
